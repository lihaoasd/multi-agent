{
  "name": "agent-haness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "本机多角色 AI 研发团队平台（设计真源见 docs/）",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch src/bootstrap/main.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "npm run typecheck && vite build --config web/vite.config.ts",
    "start": "tsx src/bootstrap/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "ratchet": "node scripts/import-ratchet.mjs",
    "coverage": "node tools/coverage-gate.mjs",
    "reindex": "tsx src/bootstrap/reindex.ts"
  },
  "dependencies": {
    "@fastify/static": "10.1.3",
    "@fastify/websocket": "11.3.0",
    "fastify": "5.12.3",
    "tsx": "4.23.13",
    "ws": "8.21.3",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.5.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "6.1.1",
    "antd": "6.6.4",
    "eslint": "10.10.0",
    "prettier": "3.9.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
