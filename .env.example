# Agent Haness 平台配置模板（复制为 .env 后按需修改；.env 不入库）
# 命名约定：`__` 表示层级；数组/对象用 JSON。改完需重启服务生效。
# 注意：模型供应商 / 模型条目**不在此配置**——由 UI"模型"模块写入
#      data/model-config.json，改完即时生效（见 docs/design/model-config.md）。
#      S14 起**没有"默认路由/全局默认模型"**：模型由 Agent 模板默认或项目内实例覆盖指定。

# ── 服务 ────────────────────────────────────────────────
SERVER__HOST=127.0.0.1
SERVER__PORT=3000
DATA_DIR=data
ROLE_DIRS=["src/shared/roles","data/roles"]

# ── 模型（引导与边界默认）────────────────────────────────
MODELS__CONFIG_FILE=data/model-config.json
MODELS__IMPORT_FROM_ENV=true
MODELS__REQUEST_TIMEOUT_MS=60000
MODELS__MAX_PROMPT_CHARS=20000
# 供应商凭证走 env 模式时使用（不要把真实密钥提交到仓库）
# DEEPSEEK_API_KEY=

# ── 审批 ────────────────────────────────────────────────
APPROVAL__HIGH_RISK_COMMANDS=true
APPROVAL__DOC_SUBMIT_APPROVAL=true
APPROVAL__CODE_SUBMIT_APPROVAL=false

# ── 沙箱 / 检索 ─────────────────────────────────────────
SANDBOX__NETWORK=online
SEARCH__ENGINE=keyword

# ── 上下文窗口（docs/design/agent-runtime.md §4）─────────
CONTEXT__SESSION__RAW_WINDOW=60
CONTEXT__SESSION__MAX_CHARS_PER_MSG=2000
CONTEXT__GLOBAL__MAX_ENTRIES=12
CONTEXT__ROLE__MAX_ENTRIES=12
CONTEXT__SEARCH__MAX_SNIPPETS=3
CONTEXT__TOOL__RESULT_MAX_CHARS=12000
