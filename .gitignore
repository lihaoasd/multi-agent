# 运行时数据（创建项目后生成：projects/{项目名}/ 等，不入库）
data/

# 测试临时目录
.test-tmp/

# 临时脚本与提交信息（演示脚本、提交说明，随用随删，不入库）
.demo-*.ts
.commitmsg*.tmp

# 依赖与构建产物
node_modules/
dist/
build/
.npm-cache/

# 日志
*.log
logs/

# 环境与密钥
.env
.env.*
# 例外：配置模板入库（docs/operations/deploy.md §3 要求）
!.env.example
*.local

# 系统文件
.DS_Store
Thumbs.db
